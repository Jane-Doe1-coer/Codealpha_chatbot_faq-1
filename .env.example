# FAQ Chatbot Configuration Template
# Copy this file to '.env' and adjust settings as needed.

# Enable/Disable local semantic search using sentence-transformers (all-MiniLM-L6-v2)
USE_SEMANTIC_SEARCH=True

# Enable/Disable local LLM conversational generation (RAG) using Ollama
USE_OLLAMA_LLM=False

# Ollama local connection settings (if USE_OLLAMA_LLM is True)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2:1b
